---
// End-of-article rights notice; the layout follows Fuwari's License block (MIT License).
import { site } from '../data/site';

interface Props {
  title: string;
  date: string;
  /** Set for reading notes: the original article keeps its own copyright. */
  source?: { name: string; url: string };
}
const { title, date, source } = Astro.props;
const pageUrl = decodeURI(new URL(Astro.url.pathname, Astro.site).href);
---
<aside class="license" aria-label="版权声明" data-pagefind-ignore>
  <p class="license-title">{title}</p>
  <a class="license-url" href={pageUrl}>{pageUrl}</a>
  <dl>
    <div><dt>作者</dt><dd>{site.author}</dd></div>
    <div><dt>日期</dt><dd>{date}</dd></div>
    {source
      ? <div><dt>原文</dt><dd><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name} ↗</a></dd></div>
      : <div><dt>许可</dt><dd><a href={site.license.url} target="_blank" rel="noopener noreferrer">{site.license.name}</a></dd></div>}
  </dl>
  <p class="license-note">
    {source
      ? '本文是阅读笔记，原文版权归原作者所有；引用内容仅用于学习和评论，完整内容请阅读原文。'
      : `转载请注明作者和出处，且不得用于商业用途。`}
  </p>
</aside>
