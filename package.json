{
  "name": "fangcun-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build --force && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "test": "pnpm build && playwright test",
    "test:e2e": "playwright test",
    "new-post": "node scripts/new-content.mjs post",
    "new-note": "node scripts/new-content.mjs note"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@expressive-code/plugin-collapsible-sections": "0.44.2",
    "@expressive-code/plugin-line-numbers": "0.44.2",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.1",
    "astro-expressive-code": "0.44.2",
    "hastscript": "9.0.1",
    "katex": "0.19.0",
    "mdast-util-to-string": "4.0.0",
    "photoswipe": "5.4.4",
    "reading-time": "1.5.0",
